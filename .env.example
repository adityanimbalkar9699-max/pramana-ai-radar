# =====================================================================
# Pramana AI Radar - Environment Configuration Template
# NEVER commit your actual .env file. Set secrets in GitHub Actions Secrets.
# =====================================================================

# --- Optional API Tokens (System works 100% without paid APIs) ---
# GitHub Personal Access Token (optional locally; automatic GITHUB_TOKEN in Actions)
GITHUB_TOKEN=

# Optional Free-Tier LLM Enrichment (Groq or Google AI Studio Gemini Free Tier)
# Leave blank to use built-in deterministic NLP & heuristic verification engine
GROQ_API_KEY=
GEMINI_API_KEY=

# --- Notification Channels (Configure the ones you want) ---
# Telegram Bot (Free via @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email via SMTP (Free via Gmail App Password or Brevo/Resend free tier)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL_TO=

# --- Automation Behavior ---
PRAMANA_DAILY_TARGET=3
PRAMANA_MIN_SCORE=55
PRAMANA_REQUEST_TIMEOUT=12
PRAMANA_LOG_LEVEL=INFO
PRAMANA_DASHBOARD_PORT=8765
